{
    "name": "svelte-hot-french-toast",
    "version": "4.1.1",
    "description": "Buttery smooth toast notifications for Svelte 5. Lightweight, customizable, and beautiful by default.",
    "license": "MIT",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build && pnpm package",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check",
        "check:watch": "svelte-kit sync && svelte-check --watch",
        "format": "prettier --log-level=warn -w .",
        "lint": "prettier -c . && eslint .",
        "package": "svelte-kit sync && svelte-package -i src/svelte-hot-french-toast && publint",
        "prepare": "svelte-kit sync",
        "prepublishOnly": "pnpm package"
    },
    "imports": {
        "#lib/*": "./src/lib/*"
    },
    "peerDependencies": {
        "svelte": "^5.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@sveltejs/adapter-static": "^4.0.1",
        "@sveltejs/kit": "^3.2.0",
        "@sveltejs/package": "^3.0.2",
        "@sveltejs/vite-plugin-svelte": "^7.3.1",
        "@tailwindcss/vite": "^4.3.5",
        "@typescript-eslint/eslint-plugin": "^8.73.0",
        "@typescript-eslint/parser": "^8.73.0",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.24.1",
        "globals": "^17.14.0",
        "phosphor-icons-svelte": "^2.1.0",
        "prettier": "^3.10.1",
        "prettier-plugin-svelte": "^4.1.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "publint": "^0.3.25",
        "shiki": "^4.6.0",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.8",
        "tailwindcss": "^4.3.5",
        "tailwindcss-addons": "^4.2.0",
        "tslib": "^2.9.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.73.0",
        "vite": "^8.3.8"
    },
    "repository": "github:babakfp/svelte-hot-french-toast",
    "files": [
        "dist",
        "header-image.png"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js"
        }
    },
    "keywords": [
        "svelte",
        "notifications",
        "toast",
        "snackbar"
    ],
    "packageManager": "pnpm@12.21.0",
    "type": "module"
}
