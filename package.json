{
    "name": "svelte-hot-french-toast",
    "version": "4.1.1",
    "description": "Buttery smooth toast notifications for Svelte 5. Lightweight, customizable, and beautiful by default.",
    "license": "MIT",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build && pnpm package",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check",
        "check:watch": "svelte-kit sync && svelte-check --watch",
        "format": "prettier -w .",
        "lint": "prettier -c . && eslint .",
        "package": "svelte-kit sync && svelte-package -i src/svelte-hot-french-toast && publint",
        "prepare": "svelte-kit sync",
        "prepublishOnly": "pnpm package"
    },
    "peerDependencies": {
        "svelte": "^5.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@sveltejs/adapter-static": "^3.0.11",
        "@sveltejs/kit": "^2.70.4",
        "@sveltejs/package": "^2.5.8",
        "@sveltejs/vite-plugin-svelte": "^6.2.4",
        "@tailwindcss/vite": "^4.3.5",
        "@typescript-eslint/eslint-plugin": "^8.73.0",
        "@typescript-eslint/parser": "^8.73.0",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-svelte": "^3.24.1",
        "globals": "^16.5.0",
        "phosphor-icons-svelte": "^2.1.0",
        "prettier": "^3.10.1",
        "prettier-plugin-svelte": "^3.5.2",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "publint": "^0.3.25",
        "shiki": "^3.23.0",
        "svelte": "^5.57.3",
        "svelte-check": "^4.7.8",
        "tailwindcss": "^4.3.5",
        "tailwindcss-addons": "^4.2.0",
        "tslib": "^2.9.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.73.0",
        "vite": "^7.3.8"
    },
    "repository": "github:babakfp/svelte-hot-french-toast",
    "files": [
        "dist",
        "header-image.png"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js"
        }
    },
    "keywords": [
        "svelte",
        "notifications",
        "toast",
        "snackbar"
    ],
    "packageManager": "pnpm@12.21.0",
    "type": "module"
}
